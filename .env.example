# Local MySQL settings. Never commit the real .env file to GitHub.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=marketflow_db

# Express API port
API_PORT=3000

# Development allows Live Server to connect. For deployment, set this to your frontend origin.
# Example: CORS_ORIGIN=https://your-marketflow.vercel.app
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501
NODE_ENV=development
